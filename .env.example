# Copy to .env.local for local development. On Vercel, add these under
# Project > Settings > Environment Variables instead. Never commit real values.

# Your store's myshopify.com domain (no https://).
SHOPIFY_STORE_DOMAIN=spdesa-qx.myshopify.com

# From Shopify admin > Sales channels > Headless > your storefront > Storefront API.
# Use the PRIVATE access token. It is only ever read on the server.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Optional alternative: the public access token, used only if no private token is set.
# SHOPIFY_STOREFRONT_PUBLIC_TOKEN=

# Optional. Storefront API version. Defaults to 2026-10.
# SHOPIFY_API_VERSION=2026-10

# The public address of this site.
NEXT_PUBLIC_SITE_URL=https://bespoke.madefromearth.com
